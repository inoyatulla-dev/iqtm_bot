# ── Telegram bot ────────────────────────────────────────
BOT_TOKEN=7xxxxxxxxxx:AAF...        # @BotFather dan
BOT_USERNAME=iqtm_bot               # @ siz

# ── Guruh ───────────────────────────────────────────────
GROUP_CHAT_ID=-100xxxxxxxxxx        # forum-guruh ID (manfiy)

# ── Boshliq (birinchi super admin) ──────────────────────
OWNER_ID=123456789                  # Telegram user ID

# ── Mini App ────────────────────────────────────────────
WEBAPP_URL=https://example.com      # Mini App HTTPS manzili (ilova ochiladi)
FRONTEND_ORIGIN=https://example.com # CORS uchun

# ── Xavfsizlik ──────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=60

# ── Baza ────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./iqtm.db
# PostgreSQL: postgresql+asyncpg://user:pass@localhost/iqtm

# ── Ishlash rejimi ──────────────────────────────────────
DEBUG=true
